# ---- OFFENSIVE: verdict discipline (choice: vulnerable / not_vulnerable / inconclusive) ----
{"id":"off-vd-001","side":"offensive","category":"off_verdict","type":"choice","state":"XSS probe reflected into an HTML attribute and the injected <script> executed (alert fired in a headless browser).","question":"What is the verdict?","candidates":{"vulnerable":"payload executed in an executable context","not_vulnerable":"input neutralized or encoded","inconclusive":"reached a sink but no execution confirmed"},"target":"vulnerable"}
{"id":"off-vd-002","side":"offensive","category":"off_verdict","type":"choice","state":"Payload reflected in the response but HTML-entity-encoded; no execution in any context.","question":"What is the verdict?","candidates":{"vulnerable":"payload executed","not_vulnerable":"reflected but encoded, no execution","inconclusive":"ambiguous"},"target":"not_vulnerable"}
{"id":"off-vd-003","side":"offensive","category":"off_verdict","type":"choice","state":"A 500 response contains a SQL fragment, but true/false payloads produce identical bodies and no timing differential.","question":"What is the verdict?","candidates":{"vulnerable":"confirmed injection","not_vulnerable":"proven safe with a positive control","inconclusive":"error seen but injection not confirmed"},"target":"inconclusive"}
{"id":"off-vd-004","side":"offensive","category":"off_verdict","type":"choice","state":"Time-based payload SLEEP(5) consistently delays the response ~5s across 3 replays; baseline is ~80ms.","question":"What is the verdict for SQL injection?","candidates":{"vulnerable":"reproducible time differential","not_vulnerable":"no differential","inconclusive":"single unreplicated observation"},"target":"vulnerable"}
{"id":"off-vd-005","side":"offensive","category":"off_verdict","type":"choice","state":"Changing the numeric id in GET /api/orders/{id} returns another user's order with their name and address.","question":"What is the verdict for IDOR?","candidates":{"vulnerable":"cross-user data returned","not_vulnerable":"access denied","inconclusive":"same-user data only"},"target":"vulnerable"}
{"id":"off-vd-006","side":"offensive","category":"off_verdict","type":"choice","state":"Changing the id in GET /api/orders/{id} to another user's id returns 403 Forbidden across all attempts.","question":"What is the verdict for IDOR?","candidates":{"vulnerable":"cross-user data returned","not_vulnerable":"authorization enforced, access denied","inconclusive":"ambiguous"},"target":"not_vulnerable"}
{"id":"off-vd-007","side":"offensive","category":"off_verdict","type":"choice","state":"SSTI probe {{7*7}} in the name field renders 49 in the response.","question":"What is the verdict for server-side template injection?","candidates":{"vulnerable":"template expression evaluated","not_vulnerable":"rendered literally","inconclusive":"blank or ambiguous"},"target":"vulnerable"}
{"id":"off-vd-008","side":"offensive","category":"off_verdict","type":"choice","state":"SSTI probe {{7*7}} is rendered back literally as {{7*7}} in the page.","question":"What is the verdict for server-side template injection?","candidates":{"vulnerable":"expression evaluated","not_vulnerable":"rendered literally, no evaluation","inconclusive":"ambiguous"},"target":"not_vulnerable"}
{"id":"off-vd-009","side":"offensive","category":"off_verdict","type":"choice","state":"A forged JWT with alg=none is sent; the server responds 401 with body 'invalid token signature'.","question":"What is the verdict for JWT alg-none bypass?","candidates":{"vulnerable":"forged token accepted","not_vulnerable":"forged token rejected","inconclusive":"ambiguous response"},"target":"not_vulnerable"}
