[Unit]
Description=Haruspex decision server
After=network.target
# Restart-rate cap (must live in [Unit]; systemd ignores it under [Service]).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Edit these for your deployment. Each adapter dir should hold a calibrator.json
# (python -m haruspex.calibrate), or that domain never abstains.
Environment=HARUSPEX_ADAPTERS=web=/opt/haruspex/web,mobile=/opt/haruspex/mobile,network=/opt/haruspex/network,llm=/opt/haruspex/llm,cloud=/opt/haruspex/cloud
Environment=HARUSPEX_DEFAULT_DOMAIN=web
# Hub downloads (adapter repo ids, the base model) need a writable cache under the sandbox.
Environment=HF_HOME=/opt/haruspex/.cache/huggingface
# Secrets go in a root-owned, mode-600 file, never in this unit: Environment= lines are
# readable by any local user via `systemctl show`. One VAR=value per line, e.g.
#   HARUSPEX_API_KEY=<secret>                         # require Bearer auth
#   HARUSPEX_AUDIT_LOG=/var/log/haruspex/audit.jsonl
EnvironmentFile=-/etc/haruspex/haruspex.env
WorkingDirectory=/opt/haruspex
ExecStart=/opt/haruspex/.venv/bin/python -m haruspex.serve --host 127.0.0.1 --port 3000

# Auto-restart on crash (the whole reason this unit exists: a lazily-loaded adapter,
# an OOM from something outside the request-size guard, or any other crash gets the
# server back up without a human paging in at 3am). Cap the retry rate so a
# persistently-crashing process doesn't spin the host.
Restart=on-failure
RestartSec=5

# The service holds the base model + N adapters in RAM/VRAM (~2 GB each on CPU) and
# does blocking inference inline — give it real memory headroom, not a tight cgroup.
MemoryHigh=16G

# Least privilege: no new privileges, private /tmp, no access outside its own dirs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/haruspex /opt/haruspex/.cache

User=haruspex
Group=haruspex

[Install]
WantedBy=multi-user.target
